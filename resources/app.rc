#include <windows.h>

#define IDI_APPICON 101

IDI_APPICON ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS 0x0L
#endif
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040704E4"
        BEGIN
            VALUE "CompanyName",      "Knosper\0"
            VALUE "FileDescription",  "NetScan\0"
            VALUE "FileVersion",      "1.0.0.0\0"
            VALUE "InternalName",     "netscan.exe\0"
            VALUE "OriginalFilename", "netscan.exe\0"
            VALUE "ProductName",      "NetScan\0"
            VALUE "ProductVersion",   "1.0.0.0\0"
            VALUE "LegalCopyright",   "Copyright (C) 2026 Knosper — MIT License\0"
        END
    END

    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0407, 1252
    END
END
